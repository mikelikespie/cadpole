# @cadpole/plan_light.star -- daylight for a plan: how deep each habitable room is lit, and how much sky a court,
# well or slot window really sees.
#
#     load("@cadpole/plan_light.star", "light_rows", "lit_share", "window_sky", "court_sky", "street_sky", "sky_table",
#          "sky_row", "SKY_TABLE", "lit_depth", "glass_doors")
#
# Two measures, both uncalibrated (nobody has matched "lit" to an eye yet; every row says so):
#
# * **Lit depth.** Facade glass -- a window onto the street, the rear, a side yard or a deck -- lights the floor
#   within twice its head height (16 ft for an 8-ft head), measured from the glass. lit_share() samples each habitable
#   room on a 1-ft grid against its own windows and those of rooms open to it through a cased opening.
# * **Sky.** A window onto a court, light well or slot gets what Cadpole's view_cone measures: the share of a 180-degree
#   by 0-89-degree band of sky in front of the glass that an eye 2 ft inside it, 2'-6" above the floor, sees past the
#   building and its neighbours (64 x 64 rays; direct sky only, nothing reflected). It is reported against a street
#   window's: a main-floor window, 8-ft head, facing a 32-ft row across a 74-ft street (the reference,
#   0.456). Its lit depth is how deep the eye can go before it sees less sky than an eye 2H behind that street window.
#
# view_cone needs bodies, so the sky measures build boxes (in a hidden layer, "plan_light") and take name=, which
# prefixes every box; everything else here is pure and records nothing. Lengths are feet; boxes are made in mm.
#
# sky_table() is the generator of SKY_TABLE (court width x wall height x floor), the table @cadpole/plan_solve.star and
# @cadpole/plan_parti.star read through sky_row() / lit_pieces() instead of measuring: it is generated by
# print(sky_table_text(sky_table())) and committed here as data.

load("@cadpole/plan.star", "courts_on", "floors_by_z", "is_habitable", "rooms_on")

_FT = 304.8  # mm per foot

LIGHT = {
    "inside": 2.0,  # the eye this far inside the glass
    "eye": 2.5,  # and this high over the floor (the work plane)
    "rays": 64,  # view_cone's rays x rays
    "head": 8.0,  # a window's head when it gives none
    "court_wall": 0.2,  # glass to the court's side of the wall (0.2 ft)
    "grow": 0.2,  # each room's box grown this far into its walls (half a 4.8-in partition: to the walls' centre lines)
    "depths": (2.0, 3.0, 4.0, 6.0, 9.0, 12.0, 16.0, 20.0),  # where a court window's sky is sampled for its lit depth
    "sky_min": 0.25,  # a habitable room seeing less than this share of a street window's sky is a mark (uncalibrated)
    "lit_min": 0.5,  # a habitable room with less of its floor than this within lit depth is a mark (uncalibrated)
    "mode": "room",  # lit_share's glass: a room's own and through cased openings ("room"), or any on the floor ("level")
}

# The reference street window: a 25-ft-wide main-floor room at 10 ft
# whose whole facade is glass to an 8-ft head, 74 ft from a 32-ft row across the street, between 32-ft neighbours.
STREET = {
    "floor_z": 10.0,
    "head": 8.0,
    "width": 25.0,  # the facade
    "along": 12.0,  # the eye's place along it (12.0 ft)
    "wall": 0.5,  # the front wall: glass at its inside face
    "deep": 12.9,  # the room and wall above the head, back from the facade
    "across": 74.0,  # facade to facade across the street
    "across_h": 32.0,
    "nb_h": 32.0,  # the neighbours either side, flush with the facade
    "top": 32.0,  # our own roof and parapet
}

_OUTDOOR = ("deck", "court", "well")
_AZ = {"N": 0.0, "E": 90.0, "S": 180.0, "W": 270.0}
_N = {"N": (0.0, 1.0), "S": (0.0, -1.0), "E": (1.0, 0.0), "W": (-1.0, 0.0)}
_FACADE = ("street", "rear", "side", "deck")

# ---------------------------------------------------------------- the pure part
def lit_depth(head = 8.0):
    """How deep facade glass lights a room: twice its head height (16 ft for an 8-ft head). Uncalibrated."""
    return 2.0 * head


def _lt(rules):
    R = dict(LIGHT)
    if rules:
        for k, v in rules.items():
            R[k] = v
    return R


def _source_kind(w):
    s = w.get("source") or "side"
    return s.split(":", 1)[0]


def _court_key(w):
    s = w.get("source") or ""
    return s.split(":", 1)[1] if ":" in s else None


def _seg(w):
    """A window's glass as a segment in plan (u, v)."""
    a = w["at"]
    h = 0.5 * w.get("width", 3.0)
    if w.get("wall") in ("N", "S"):
        return (a[0] - h, a[1], a[0] + h, a[1])
    return (a[0], a[1] - h, a[0], a[1] + h)


def _seg_dist(p, s):
    du, dv = s[2] - s[0], s[3] - s[1]
    L2 = du * du + dv * dv
    t = 0.0
    if L2 > 1e-12:
        t = ((p[0] - s[0]) * du + (p[1] - s[1]) * dv) / L2
        t = max(0.0, min(1.0, t))
    x, y = s[0] + t * du, s[1] + t * dv
    return math.hypot(p[0] - x, p[1] - y)


def _floor_of_window(plan, w):
    if w.get("floor"):
        return w["floor"]
    for r in plan.get("rooms", []):
        if r["key"] == w.get("room"):
            return r["floor"]
    return None


def _open_to(plan, key):
    """Rooms joined to this one by a cased opening (a door with no leaf): they share their light."""
    out = []
    for d in plan.get("doors", []):
        if d.get("swing") != "open":
            continue
        if d["a"] == key and not (d.get("b") or "").startswith("outside"):
            out.append(d["b"])
        elif d.get("b") == key:
            out.append(d["a"])
    return out


def glass_doors(plan, head = 8.0):
    """Sliding doors from a room to the outside or onto a deck, as windows (a sliding door there is glass): the window
    records lit_share and the light rows count with the windows."""
    rooms = {r["key"]: r for r in plan.get("rooms", [])}
    out = []
    for d in plan.get("doors", []):
        if d.get("swing") != "slide" or d.get("at") == None or d.get("wall") not in _N:
            continue
        b = d.get("b") or ""
        if b.startswith("outside"):
            src = "street" if b == "outside:street" else ("deck" if b == "outside:deck" else "rear")
        elif rooms.get(b, {}).get("kind") == "deck":
            src = "deck"
        else:
            continue
        out.append({"key": d.get("key"), "floor": d.get("floor"), "room": d["a"], "wall": d["wall"], "at": d["at"], "width": d.get("width", 3.0),
                    "sill": 0.0, "head": head, "source": src, "door": True})
    return out


def lit_share(plan, floor, court_lit = None, depth = None, step = 1.0, rules = None):
    """The habitable floor on `floor` within lit depth of glass, sampled on a `step`-ft grid:
    {"total": sq ft, "lit": sq ft, "share": 0..1, "rooms": {key: (sq ft, lit sq ft)}}.

    Facade glass (street, rear, side, deck) lights to depth= if given (15 for a level-wide measure), else
    to twice its head. A court, well or slot window lights to court_lit[window key] when the caller measured it
    (light_rows does), else not at all. rules mode "room" counts a room's own glass and that of rooms open to it
    through a cased opening; "level" counts any glass on the floor, through walls."""
    R = _lt(rules)
    wins = [w for w in plan.get("windows", []) + glass_doors(plan) if _floor_of_window(plan, w) == floor and w.get("wall") in _N and w.get("at") != None]
    glass = []
    for w in wins:
        k = _source_kind(w)
        if k in _FACADE:
            L = depth if depth != None else lit_depth(w.get("head", R["head"]))
        else:
            L = (court_lit or {}).get(w.get("key"))
            if L == None:
                continue
        glass.append((_seg(w), L, w.get("room")))
    rooms = [r for r in rooms_on(plan, floor) if is_habitable(r) and r.get("kind") not in _OUTDOOR]
    tot, lit = 0.0, 0.0
    per = {}
    for r in rooms:
        if R["mode"] == "level":
            mine = glass
        else:
            ok = {r["key"]: True}
            for o in _open_to(plan, r["key"]):
                ok[o] = True
            mine = [g for g in glass if g[2] in ok]
        ra, rl = 0.0, 0.0
        for q in r["rects"]:
            nu = max(int((q[1] - q[0]) / step + 0.5), 1)
            nv = max(int((q[3] - q[2]) / step + 0.5), 1)
            du, dv = (q[1] - q[0]) / nu, (q[3] - q[2]) / nv
            cell = du * dv
            for i in range(nu):
                for j in range(nv):
                    p = (q[0] + (i + 0.5) * du, q[2] + (j + 0.5) * dv)
                    ra += cell
                    for g in mine:
                        if _seg_dist(p, g[0]) <= g[1] + 1e-9:
                            rl += cell
                            break
        per[r["key"]] = (ra, rl)
        tot += ra
        lit += rl
    return {"total": tot, "lit": lit, "share": lit / tot if tot > 0 else 1.0, "rooms": per}


# ---------------------------------------------------------------- boxes for view_cone (these make features)
def _ctx(name):
    return {"prefix": name, "n": [0], "layer": layer("plan_light", doc = "the boxes plan_light's sky measures see", visible = False)}


def _box(ctx, x0, x1, y0, y1, z0, z1):
    """A box between two corners in feet, as a body in mm on the hidden layer; None when it is empty."""
    if x1 - x0 <= 1e-6 or y1 - y0 <= 1e-6 or z1 - z0 <= 1e-6:
        return None
    ctx["n"][0] += 1
    return box((x1 - x0) * _FT, (y1 - y0) * _FT, (z1 - z0) * _FT, at = (x0 * _FT, y0 * _FT, z0 * _FT),
               name = "%s_%d" % (ctx["prefix"], ctx["n"][0]), layer = ctx["layer"])


def _fan(eye, az, obstacles, rays):
    f = view_cone((eye[0] * _FT, eye[1] * _FT, eye[2] * _FT), az = az, fov = 180, el = (0, 89), obstacles = obstacles, rays = rays, north = 0)
    return f.fraction


def _keep(xs):
    return [x for x in xs if x != None]


def street_sky(depths = (2.0,), floor_z = None, head = None, rays = None, name = "plan_light_street", **geom):
    """The reference: the sky a street window sees, eye `depth` ft inside its glass, for each depth: {depth: fraction}.
    The geometry is STREET's, any key of it overridable by keyword. Makes boxes named name_<n>."""
    S = dict(STREET)
    for k, v in geom.items():
        S[k] = v
    if floor_z != None:
        S["floor_z"] = floor_z
    if head != None:
        S["head"] = head
    n = rays or LIGHT["rays"]
    ctx = _ctx(name)
    W, z, t = S["width"], S["floor_z"], S["top"]
    deep = max(S["deep"], S["wall"] + max(depths) + 3.0)  # the room runs past every eye
    # local frame: the facade's outer face at y = 0, the street toward -y, x along the facade from its west end
    obs = _keep([
        _box(ctx, 0.0, W, 0.0, deep, z + S["head"], t),  # the wall and floors above the head
        _box(ctx, 0.0, W, 0.0, deep + 30.0, 0.0, z),  # the floors below
        _box(ctx, W, W + 35.0, 0.0, 65.0, 0.0, S["nb_h"]),  # the neighbours, flush with the facade
        _box(ctx, -35.0, 0.0, 0.0, 65.0, 0.0, S["nb_h"]),
        _box(ctx, -100.0, W + 100.0, -S["across"] - 51.0, -S["across"], 0.0, S["across_h"]),  # across the street
    ])
    out = {}
    for d in depths:
        out[d] = _fan((S["along"], S["wall"] + d, z + LIGHT["eye"]), 180.0, obs, n)
    return out


def court_sky(w, top, floor_z = 0.0, depths = (2.0,), head = 8.0, span = None, length = 20.0, along = None, front = 12.0,
              rear = 12.0, back = 17.0, opp = None, opp_top = None, wall = None, rays = None, name = "plan_light_court"):
    """The sky a window onto a court sees, eye `depth` ft inside the glass, for each depth: {depth: fraction}.

    The court's frame: our wall's court face at x = 0, the court x 0..w (w: clear to the far wall), y 0..`length`
    along the window wall, open from the window's floor up to `top` (all heights from the court's own datum, so a
    window on the court's base floor has floor_z = 0 when top is the wall height). The window's opening runs
    span=(y0, y1) along the court (all of it by default) from the floor to `head`; our side is solid outside it and
    above the head. The court is closed by our building `front` ft deep before y 0 and `rear` ft deep past `length`
    (0: open to a yard there); the far wall runs opp=(y0, y1) (the court and 12 ft beyond by default) to opp_top (top).
    `along` puts the eye (the middle of the span by default). Makes boxes named name_<n>."""
    n = rays or LIGHT["rays"]
    sp = span or (0.0, length)
    o = opp or (-front - 12.0 if front > 0 else -12.0, length + (rear if rear > 0 else 0.0) + 12.0)
    ot = opp_top if opp_top != None else top
    wt = wall if wall != None else LIGHT["court_wall"]
    back = max(back, wt + max(depths) + 3.0)  # the room runs past every eye
    ctx = _ctx(name)
    obs = _keep([
        _box(ctx, -back, 0.0, sp[0], sp[1], floor_z + head, top),  # above the head
        _box(ctx, -back, 0.0, 0.0, sp[0], 0.0, top),  # our side beside the opening
        _box(ctx, -back, 0.0, sp[1], length, 0.0, top),
        _box(ctx, -back, w, -front, 0.0, 0.0, top) if front > 0 else None,  # the court's ends
        _box(ctx, -back, w, length, length + rear, 0.0, top) if rear > 0 else None,
        _box(ctx, w, w + 35.0, o[0], o[1], 0.0, ot),  # the far wall
    ])
    y = along if along != None else 0.5 * (sp[0] + sp[1])
    out = {}
    for d in depths:
        out[d] = _fan((-(wt + d), y, floor_z + LIGHT["eye"]), 90.0, obs, n)
    return out


def _crossing(fr, depths, T):
    """The depth where the sampled fraction falls to T (interpolated), 0 if it starts below, the last depth if never."""
    prev = None
    for d in depths:
        f = fr[d]
        if f < T:
            if prev == None:
                return 0.0
            d0, f0 = prev
            if f0 - f <= 1e-12:
                return d0
            return d0 + (d - d0) * (f0 - T) / (f0 - f)
        prev = (d, f)
    return depths[-1]


def street_reference(head = 8.0, rays = None, name = "plan_light_ref"):
    """The street window's sky 2 ft inside (the share every court window is reported against) and at 2H (the least
    sky that is still "lit"): {"near": fraction, "far": fraction, "head": head}. Makes boxes."""
    fr = street_sky(depths = (2.0, 2.0 * head), head = head, rays = rays, name = name)
    return {"near": fr[2.0], "far": fr[2.0 * head], "head": head}


def sky_table(widths = (4.0, 6.0, 8.0, 10.0, 12.0, 16.0, 20.0), heights = (10.0, 20.0, 30.0, 40.0), floors = (0, 1, 2, 3),
              storey = 10.0, head = 8.0, length = 20.0, rays = None, name = "plan_light_table"):
    """The generator of SKY_TABLE: for each court width w (clear, ft), wall height h (the court's walls above its base)
    and floor k (the window's floor above the base, storey ft each, its head under the top), the sky an eye 2 ft
    inside sees, its share of the street reference's, and its lit depth (the depth where it falls to the street
    window's sky at 2H): [{"w", "h", "floor", "above" (wall over the head), "sky", "rel", "lit"}]. A 20-ft court,
    closed at both ends by 12 ft of building, the far wall as tall as ours. Makes boxes; about 2 s a hundred cells."""
    ref = street_reference(head = head, rays = rays, name = name + "_ref")
    depths = LIGHT["depths"]
    out = []
    i = 0
    for h in heights:
        for k in floors:
            z = k * storey
            if z + head > h + 1e-9:
                continue
            for w in widths:
                i += 1
                fr = court_sky(w, h, floor_z = z, depths = depths, head = head, length = length, rays = rays, name = "%s_%d" % (name, i))
                out.append({"w": w, "h": h, "floor": k, "above": h - z - head, "sky": fr[2.0], "rel": fr[2.0] / ref["near"],
                            "lit": _crossing(fr, depths, ref["far"])})
    return out


