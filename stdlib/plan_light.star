def sky_table_text(T):
    """A sky table as Starlark source, for committing as SKY_TABLE: print(sky_table_text(sky_table()))."""
    lines = ["SKY_TABLE = ["]
    for r in T:
        lines.append('    {"w": %s, "h": %s, "floor": %d, "above": %s, "sky": %s, "rel": %s, "lit": %s},' % (
            format(r["w"], ".1f"), format(r["h"], ".1f"), r["floor"], format(r["above"], ".1f"), format(r["sky"], ".9f"),
            format(r["rel"], ".9f"), format(r["lit"], ".6f")))
    lines.append("]")
    return "\n".join(lines)


def _interp(a0, a1, t):
    return a0 + (a1 - a0) * t


def sky_row(w, h, floor = 0, table = None):
    """The sky table's row for court width w and wall height h at floor k, interpolated in w and h (clamped to the
    table): {"w", "h", "floor", "sky", "rel", "lit"}, or None when the table has no row for that floor."""
    T = table if table != None else SKY_TABLE
    rows = [r for r in T if r["floor"] == floor]
    if not rows:
        return None
    ws = sorted({r["w"]: 1 for r in rows}.keys())
    hs = sorted({r["h"]: 1 for r in rows}.keys())

    def bracket(xs, x):
        x = max(xs[0], min(xs[-1], x))
        for i in range(len(xs) - 1):
            if x <= xs[i + 1]:
                return (xs[i], xs[i + 1], (x - xs[i]) / (xs[i + 1] - xs[i]) if xs[i + 1] > xs[i] else 0.0)
        return (xs[-1], xs[-1], 0.0)

    w0, w1, tw = bracket(ws, w)
    h0, h1, th = bracket(hs, h)
    cell = {}
    for r in rows:
        cell[(r["w"], r["h"])] = r

    def at(ww, hh, key):
        r = cell.get((ww, hh))
        if r == None:
            # a height with no row at this floor (the head over the top): the nearest height that has one
            cands = [x for x in rows if x["w"] == ww]
            r = sorted(cands, key = lambda x: abs(x["h"] - hh))[0]
        return r[key]

    res = {"w": w, "h": h, "floor": floor}
    for key in ("sky", "rel", "lit"):
        a = _interp(at(w0, h0, key), at(w1, h0, key), tw)
        b = _interp(at(w0, h1, key), at(w1, h1, key), tw)
        res[key] = _interp(a, b, th)
    return res


def lit_pieces(h, floor = 0, table = None):
    """The lit depth against court width at one wall height and floor, as breakpoints [(w, lit)] for a solver to
    encode (it is concave in w over the table's range, so a maximised depth may take the lower envelope)."""
    T = table if table != None else SKY_TABLE
    ws = sorted({r["w"]: 1 for r in T if r["floor"] == floor}.keys())
    return [(w, sky_row(w, h, floor, T)["lit"]) for w in ws]


# ---------------------------------------------------------------- a plan's own massing, for its windows' sky
def _floors(plan):
    return floors_by_z(plan)


def _z(plan, fk):
    for f in plan.get("floors", []):
        if f.get("key") == fk:
            return f.get("z", 0.0)
    return 0.0


def _next_z(plan, fk):
    fl = _floors(plan)
    for i, f in enumerate(fl):
        if f["key"] == fk:
            if i + 1 < len(fl):
                return fl[i + 1].get("z", 0.0)
            return None
    return None


def _top(plan):
    """The top of the building: the courts' open-sky elevation, or the top floor's ceiling and 2 ft of roof."""
    t = None
    for c in plan.get("courts", []):
        if c.get("top") != None:
            t = c["top"] if t == None else max(t, c["top"])
    fl = _floors(plan)
    if fl:
        f = fl[-1]
        rt = f.get("z", 0.0) + (f.get("ceiling") or 9.0) + 2.0
        t = rt if t == None else max(t, rt)
    return t if t != None else 30.0


def _grown(q, g, voids):
    """Rect q grown by g on every side, but not into a void (a court) it does not already touch."""
    u0, u1, v0, v1 = q[0] - g, q[1] + g, q[2] - g, q[3] + g
    for c in voids:
        if c[2] < q[3] and c[3] > q[2]:  # beside it in v
            if c[0] >= q[1] - 1e-9 and c[0] < u1:
                u1 = c[0]
            if c[1] <= q[0] + 1e-9 and c[1] > u0:
                u0 = c[1]
        if c[0] < q[1] and c[1] > q[0]:
            if c[2] >= q[3] - 1e-9 and c[2] < v1:
                v1 = c[2]
            if c[3] <= q[2] + 1e-9 and c[3] > v0:
                v0 = c[3]
    return (u0, u1, v0, v1)


def massing(plan, name = "plan_light_mass", rules = None):
    """The plan as boxes view_cone can see: every indoor room on every floor from its floor to the next (the top
    floor to the courts' tops), grown into its walls but not into a court, and the site's neighbours:
    {"rooms": [(body, floor, room key)], "others": [body], "ctx": ...}. Makes boxes."""
    R = _lt(rules)
    ctx = _ctx(name)
    top = _top(plan)
    out = []
    for f in _floors(plan):
        fk = f["key"]
        z0 = f.get("z", 0.0)
        nz = _next_z(plan, fk)
        z1 = nz if nz != None else max(top, z0 + (f.get("ceiling") or 9.0) + 2.0)
        voids = [c["rect"] for c in courts_on(plan, fk)]
        for r in rooms_on(plan, fk):
            if r.get("kind") in _OUTDOOR:
                continue
            for q in r["rects"]:
                g = _grown(q, R["grow"], voids)
                b = _box(ctx, g[0], g[1], g[2], g[3], z0, z1)
                if b != None:
                    out.append((b, fk, r["key"]))
    others = []
    grade = plan.get("site", {}).get("grade", 0.0)
    for nb in plan.get("site", {}).get("neighbors", []):
        q = nb["rect"]
        b = _box(ctx, q[0], q[1], q[2], q[3], grade, grade + nb.get("height", 32.0))
        if b != None:
            others.append(b)
    return {"rooms": out, "others": others, "ctx": ctx, "top": top}


def window_sky(plan, w, M = None, depths = (2.0,), rules = None, name = "plan_light_win"):
    """The sky window `w` (a plan window record) sees, eye `depth` ft inside it for each depth: {depth: fraction},
    from the plan's own massing (massing(), passed as M to share it between windows) less the window's room on its
    floor, plus that room's wall above the head."""
    R = _lt(rules)
    if M == None:
        M = massing(plan, name = name + "_mass", rules = rules)
    fk = _floor_of_window(plan, w)
    rk = w.get("room")
    z = _z(plan, fk)
    nz = _next_z(plan, fk)
    z1 = nz if nz != None else M["top"]
    head = w.get("head", R["head"])
    voids = [c["rect"] for c in courts_on(plan, fk)]
    room = None
    for r in plan.get("rooms", []):
        if r["key"] == rk:
            room = r
    ctx = _ctx(name)
    above = []
    if room != None:
        for q in room["rects"]:
            g = _grown(q, R["grow"], voids)
            above.append(_box(ctx, g[0], g[1], g[2], g[3], z + head, z1))
    obs = [b for (b, f, k) in M["rooms"] if not (f == fk and k == rk)] + _keep(above) + M["others"]
    n = _N[w["wall"]]
    reach = _room_reach(room, w) if room != None else None
    out = {}
    for d in depths:
        if reach != None and d > reach - 0.25:
            out[d] = 0.0  # past the room's far wall: not this window's to light
            continue
        eye = (w["at"][0] - n[0] * d, w["at"][1] - n[1] * d, z + R["eye"])
        out[d] = _fan(eye, _AZ[w["wall"]], obs, R["rays"])
    return out


def _room_reach(room, w):
    """How far into its room a window can see straight in: from its wall to the far side of the rect it is in."""
    a = w["at"]
    best = None
    for q in room["rects"]:
        if w["wall"] in ("E", "W"):
            if a[1] < q[2] - 0.05 or a[1] > q[3] + 0.05:
                continue
            d = (a[0] - q[0]) if w["wall"] == "E" else (q[1] - a[0])
        else:
            if a[0] < q[0] - 0.05 or a[0] > q[1] + 0.05:
                continue
            d = (a[1] - q[2]) if w["wall"] == "N" else (q[3] - a[1])
        if d > 0 and (best == None or d > best):
            best = d
    return best


# ---------------------------------------------------------------- the rows
def _ftin(x):
    n = int(math.round(abs(x) * 12.0))
    return "%s%d'-%d\"" % ("-" if x < 0 and n > 0 else "", n // 12, n % 12)


def _pct(x):
    if x < 0.095 and x > 0:
        return format(100.0 * x, ".0f") + "%" if x >= 0.0095 else "under 1%"
    return format(100.0 * x, ".0f") + "%"


def _row(what, floor, room, ok, name, detail, severity, at = None, rect = None):
    r = {"key": "light:%s:%s:%s" % (what, floor or "-", room or "-"), "name": name, "ok": ok, "detail": detail,
         "rule": "light (uncalibrated)", "severity": severity, "floor": floor, "room": room}
    if at != None:
        r["at"] = (at[0], at[1])
    if rect != None:
        r["rect"] = tuple(rect)
    return r


_UNCAL = "uncalibrated: nobody has matched these thresholds to an eye"


def light_rows(plan, rules = None, measure = True, name = None):
    """The light family's rows: for each window onto a court, well or slot, the sky view_cone measures against a
    street window's, and its lit depth (measure=False estimates both from SKY_TABLE by the court's width and height);
    for each floor, the habitable floor within lit depth; for each habitable room lit under rules lit_min, a mark.
    Every threshold is uncalibrated and every row says so. measure=True makes boxes (name= prefixes them)."""
    R = _lt(rules)
    nm = name or ("plan_light_" + str(plan.get("name") or "plan").replace(" ", "_").replace("-", "_"))
    rows = []
    rooms = {r["key"]: r for r in plan.get("rooms", [])}
    cw = [w for w in plan.get("windows", []) if _source_kind(w) in ("court", "well", "slot") and w.get("wall") in _N and w.get("at") != None]
    court_lit = {}
    court_dark = {}
    if cw:
        M = massing(plan, name = nm + "_mass", rules = rules) if measure else None
        refs = {}

        def ref_for(h):
            if h not in refs:
                refs[h] = street_reference(head = h, rays = R["rays"], name = "%s_ref%d" % (nm, len(refs)))
            return refs[h]

        for i, w in enumerate(cw):
            r = rooms.get(w.get("room"))
            if r == None:
                continue
            head = w.get("head", R["head"])
            fk = _floor_of_window(plan, w)
            ck = _court_key(w)
            how = ""
            if measure:
                base = ref_for(R["head"])
                ref = ref_for(head)
                fr = window_sky(plan, w, M, depths = R["depths"], rules = rules, name = "%s_w%d" % (nm, i))
                sky = fr[2.0]
                rel = sky / base["near"] if base["near"] > 0 else 0.0
                lit = _crossing(fr, R["depths"], ref["far"])
                how = "view_cone %s against %s" % (format(sky, ".3f"), format(base["near"], ".3f"))
            else:
                c = None
                for x in plan.get("courts", []):
                    if x["key"] == ck:
                        c = x
                if c == None:
                    continue
                q = c["rect"]
                width = (q[1] - q[0]) if w["wall"] in ("E", "W") else (q[3] - q[2])
                bz = _z(plan, c.get("base"))
                k = int(math.round((_z(plan, fk) - bz) / 10.0))
                est = sky_row(width, c["top"] - bz, max(k, 0))
                if est == None:
                    continue
                sky, rel, lit = est["sky"], est["rel"], est["lit"]
                how = "estimated from SKY_TABLE, a %s court %s high" % (_ftin(width), _ftin(c["top"] - bz))
            court_lit[w.get("key")] = lit
            hab = is_habitable(r)
            # a room with facade glass of its own is not lit by the court: its court window is a note
            facade = [x for x in plan.get("windows", []) + glass_doors(plan) if x.get("room") == r["key"] and _source_kind(x) in _FACADE]
            depends = hab and not facade
            ok = rel >= R["sky_min"] or not depends
            if not ok:
                court_dark[r["key"]] = True
            rows.append(_row("sky-" + (w.get("key") or str(i)), fk, r["key"], ok,
                             "Court, well and slot windows: the sky view_cone measures",
                             "%s: its %s window sees %s of a street window's sky; lit %s deep (street glass: %s)" % (
                                 r.get("name") or r["key"], (w.get("source") or "").replace(":", " "), _pct(rel), _ftin(lit), _ftin(lit_depth(head))) +
                             ("" if depends or not hab else "; the room has facade glass too") + "; %s; %s" % (how, _UNCAL),
                             "warn" if depends else "note", at = w["at"]))
    for f in _floors(plan):
        fk = f["key"]
        s = lit_share(plan, fk, court_lit = court_lit, rules = rules)
        if s["total"] <= 0:
            continue
        rows.append(_row("share", fk, None, True, "Habitable floor within lit depth of glass (2H, or a court's measured depth)",
                         "%s: %s of %s sq ft of habitable floor within lit depth (%s)" % (
                             fk, _pct(s["share"]), format(s["total"], ",.0f"), _UNCAL), "note"))
        for k, (a, l) in s["rooms"].items():
            if a <= 0:
                continue
            share = l / a
            if share < R["lit_min"] and k not in court_dark:  # a room its court leaves dark has its mark already
                r = rooms[k]
                rows.append(_row("dark", fk, k, False, "Habitable rooms lit through at least half their floor",
                                 "%s: %s of its floor within lit depth of its glass; %s" % (r.get("name") or k, _pct(share), _UNCAL),
                                 "warn", rect = r["rects"][0]))
    return rows
