     } else {
-        let abs = f.abs();
-        let exponent = if f == 0.0 {
-            0
+        // Round the whole mantissa at once, with the carry: Rust's `{:e}`
+        // is exact decimal conversion, so 1.9999997e6 at six digits is
+        // `2.000000e6`. Writing the leading digit first and rounding the
+        // tail separately dropped the carry when the tail rounded up to
+        // 10^precision (1999999.7 came out as `1e+06`). Patched by Cadpole;
+        // see build_support/patches/starlark_float_carry.patch.
+        let sci = format!("{:.*e}", WRITE_PRECISION, f.abs());
+        let (mantissa, exponent) = sci.split_once('e').unwrap_or((&sci, "0"));
+        let exponent: i32 = exponent.parse().unwrap_or(0);
+        let mantissa = if strip_trailing_zeros && mantissa.contains('.') {
+            mantissa.trim_end_matches('0').trim_end_matches('.')
         } else {
-            abs.log10().floor() as i32
-        };
-        let normal = if f == 0.0 {
-            0.0
-        } else {
-            abs / 10f64.powf(exponent as f64)
+            mantissa
