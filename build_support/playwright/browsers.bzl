"""Hermetic Playwright browsers.

`@playwright/test` normally downloads its browsers into `~/.cache/ms-playwright`
at `npm install` time, which makes every test that uses it depend on machine
state. This repository rule downloads the *exact* browser build the pinned
`@playwright/test` asks for, sha256-pinned, and lays it out in the directory
shape Playwright's registry looks for, so `PLAYWRIGHT_BROWSERS_PATH` can point
at runfiles instead:

    <cache>/chromium_headless_shell-<revision>/INSTALLATION_COMPLETE
    <cache>/chromium_headless_shell-<revision>/chrome-headless-shell-linux64/chrome-headless-shell

Every constant below is read out of `node_modules/playwright-core` (which
rules_js materialises under `bazel-bin/node_modules/.aspect_rules_js/`):

  * `browsers.json`     -- the revision and the Chrome for Testing version;
  * `lib/coreBundle.js` -- `DOWNLOAD_PATHS` (the CDN path per host platform,
                           built by `cftUrl()`), `EXECUTABLE_PATHS` (where the
                           binary sits inside the archive) and the
                           `<name with _ for -> - <revision>` cache directory
                           naming in `readDescriptors()`.

To bump: change `@playwright/test` in `src/web/package.json`, re-run
`cd src/web && pnpm install --lockfile-only`, then
`bazel build //src/web:node_modules/@playwright/test` and read the new
`revision` / `browserVersion` out of
`bazel-bin/node_modules/.aspect_rules_js/playwright-core@<v>/node_modules/playwright-core/browsers.json`.
Update the constants here; a failing fetch prints the sha256 to paste back.
"""

# Pinned to @playwright/test 1.63.0 (src/web/package.json, //:pnpm-lock.yaml).
PLAYWRIGHT_VERSION = "1.63.0"

# chromium-headless-shell revision 1243 == Chrome for Testing 153.0.8010.12.
CHROMIUM_REVISION = "1243"

CHROMIUM_BROWSER_VERSION = "153.0.8010.12"

# Playwright's cache directory name for this browser (registry.ts
# `readDescriptors`: `${name.replace(/-/g, "_")}-${revision}`).
CHROMIUM_BROWSER_DIR = "chromium_headless_shell-" + CHROMIUM_REVISION

# Per-host-platform archive suffix (playwright-core `DOWNLOAD_PATHS`) and its
# sha256. Only linux-x86_64 is exercised in CI; macos-aarch64 is here so
# `bazel test //src/web:e2e_test` also works on an Apple silicon laptop.
CHROMIUM_ARCHIVES = {
    "linux-x86_64": struct(
        path = "linux64/chrome-headless-shell-linux64.zip",
        sha256 = "a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d",
    ),
    "macos-aarch64": struct(
        path = "mac-arm64/chrome-headless-shell-mac-arm64.zip",
        sha256 = "89d80a6d26ccd0ccfd51e22d9e1297283862af2b0cd91dce07459b35ca0059f2",
    ),
}

# playwright-core `PLAYWRIGHT_CDN_MIRRORS`, plus the Chrome for Testing bucket
# that cdn.playwright.dev redirects to for `builds/cft/...`.
_MIRRORS = [
    "https://cdn.playwright.dev/builds/cft/{version}/{path}",
    "https://playwright.download.prss.microsoft.com/dbazure/download/playwright/builds/cft/{version}/{path}",
    "https://storage.googleapis.com/chrome-for-testing-public/{version}/{path}",
]

_BUILD_FILE = '''\
# Generated by //build_support/playwright:browsers.bzl. Do not edit.
package(default_visibility = ["//visibility:public"])

# The whole browser, laid out the way Playwright's registry expects to find it
# under PLAYWRIGHT_BROWSERS_PATH.
filegroup(
    name = "browsers",
    srcs = [":marker"] + glob(["{browser_dir}/**"], allow_empty = False),
)

# One stable file at the root of the cache directory. playwright_test passes
# its $(rlocationpath) to the runner, which takes its dirname as
# PLAYWRIGHT_BROWSERS_PATH.
filegroup(
    name = "marker",
    srcs = ["playwright-browsers.marker"],
)
'''

def _playwright_browser_impl(rctx):
    rctx.download_and_extract(
        url = [m.format(version = rctx.attr.browser_version, path = rctx.attr.archive_path) for m in _MIRRORS],
        sha256 = rctx.attr.sha256,
        type = "zip",
        output = rctx.attr.browser_dir,
    )

    # browserFetcher.ts writes this marker after a successful install, and
    # the registry treats a browser directory without it as not installed.
    rctx.file(rctx.attr.browser_dir + "/INSTALLATION_COMPLETE", "")

    # Not a browser directory as far as `isBrowserDirectory()` is concerned
    # (it does not start with a known browser name), so Playwright ignores it.
    rctx.file("playwright-browsers.marker", "Playwright browser cache (Bazel).\n")
    rctx.file("BUILD.bazel", _BUILD_FILE.format(browser_dir = rctx.attr.browser_dir))

playwright_browser = repository_rule(
    implementation = _playwright_browser_impl,
    doc = "Downloads one sha256-pinned Playwright browser build into a Playwright-shaped cache directory.",
    attrs = {
        "archive_path": attr.string(
            mandatory = True,
            doc = "Path under builds/cft/<version>/, e.g. linux64/chrome-headless-shell-linux64.zip.",
        ),
        "browser_dir": attr.string(
            mandatory = True,
            doc = "Playwright cache directory name, e.g. chromium_headless_shell-1243.",
        ),
        "browser_version": attr.string(
            mandatory = True,
            doc = "Chrome for Testing version, e.g. 153.0.8010.12.",
        ),
        "sha256": attr.string(mandatory = True),
    },
)
