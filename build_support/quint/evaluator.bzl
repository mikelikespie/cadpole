"""The Quint Rust evaluator, fetched by Bazel and sha256-pinned.

Quint's fast simulation backend (`--backend=rust`) is not part of the npm
package. `dist/src/rust/binaryManager.js` looks for

    $QUINT_HOME/rust-evaluator-<version>/quint_evaluator

and, when it is not there, reaches out to the GitHub releases API and downloads
it -- at *test* time, unpinned, into `~/.quint`. That is the one thing nothing
else in this repository does: the licence inventories, the advisory snapshots
and the Playwright browser are all pinned and fetched by Bazel.

So this rule downloads the exact evaluator build that the pinned
`@informalsystems/quint` asks for, checks its sha256, and lays it out in the
directory shape `binaryManager.js` looks for, so `QUINT_HOME` can point at
runfiles and the download branch is never taken. `//spec:quint_test` also runs
with `block-network`, so if this ever stopped matching, the test would fail
loudly rather than quietly fetching a different binary.

To bump: change `@informalsystems/quint` in `spec/package.json`, re-run
`pnpm install --lockfile-only`, read `QUINT_EVALUATOR_VERSION` out of
`bazel-bin/spec/node_modules/.aspect_rules_js/@informalsystems+quint@<v>/node_modules/@informalsystems/quint/dist/src/rust/binaryManager.js`,
update the constants below and paste back the sha256s a failing fetch prints.
"""

# Pinned to @informalsystems/quint 0.32.0 (spec/package.json, //:pnpm-lock.yaml):
# `QUINT_EVALUATOR_VERSION` in dist/src/rust/binaryManager.js.
QUINT_VERSION = "0.32.0"

QUINT_EVALUATOR_VERSION = "v0.6.0"

# `rustEvaluatorDir()` in dist/src/config.js.
QUINT_EVALUATOR_DIR = "rust-evaluator-" + QUINT_EVALUATOR_VERSION

# Asset name per host, from `inferAssetAndExecutableNames()` in
# binaryManager.js, and its sha256. Only the branch the `select()` in
# //build_support/quint:BUILD.bazel picks is ever downloaded (~1 MB).
QUINT_EVALUATOR_ARCHIVES = {
    "linux-x86_64": struct(
        triple = "x86_64-unknown-linux-gnu",
        sha256 = "61755a09d5052d93a4e75e840059edfd0d3674aeda164b9d2464be3d6e21b1c2",
    ),
    "linux-aarch64": struct(
        triple = "aarch64-unknown-linux-gnu",
        sha256 = "07e5ec9c756feba0db59987c9f90456dacfecf75f64f111b791b66c770a293d2",
    ),
    "macos-aarch64": struct(
        triple = "aarch64-apple-darwin",
        sha256 = "5d15ae38ef9bee3da14a29486d9a65bfbc27c3074adb96a2a89d457215ec8bd5",
    ),
    "macos-x86_64": struct(
        triple = "x86_64-apple-darwin",
        sha256 = "dcebb5a58372c77b47a3a419419d182b62cc7604a9be89a24e2c37b19217b038",
    ),
}

# The project moved from informalsystems/quint to quint-co/quint; the old host
# still redirects, and is kept as a second URL so a fetch survives either one
# going away. The sha256 is what actually decides whether the bytes are right.
_MIRRORS = [
    "https://github.com/quint-co/quint/releases/download/evaluator/{version}/quint_evaluator-{triple}.tar.gz",
    "https://github.com/informalsystems/quint/releases/download/evaluator/{version}/quint_evaluator-{triple}.tar.gz",
]

_BUILD_FILE = '''\
# Generated by //build_support/quint:evaluator.bzl. Do not edit.
package(default_visibility = ["//visibility:public"])

# The evaluator laid out under a QUINT_HOME-shaped directory.
filegroup(
    name = "evaluator",
    srcs = [":marker", "{dir}/quint_evaluator"],
)

# One stable file at the root of that directory. `quint_test` passes its
# $(rlocationpath) to runner.mjs, which takes its dirname as QUINT_HOME.
filegroup(
    name = "marker",
    srcs = ["quint-home.marker"],
)
'''

def _quint_evaluator_impl(rctx):
    rctx.download_and_extract(
        url = [
            m.format(version = QUINT_EVALUATOR_VERSION, triple = rctx.attr.triple)
            for m in _MIRRORS
        ],
        sha256 = rctx.attr.sha256,
        type = "tar.gz",
        output = QUINT_EVALUATOR_DIR,
    )
    rctx.file("quint-home.marker", "QUINT_HOME (Bazel-pinned Quint evaluator).\n")
    rctx.file("BUILD.bazel", _BUILD_FILE.format(dir = QUINT_EVALUATOR_DIR))

quint_evaluator = repository_rule(
    implementation = _quint_evaluator_impl,
    doc = "Downloads one sha256-pinned quint_evaluator build into a QUINT_HOME-shaped directory.",
    attrs = {
        "sha256": attr.string(mandatory = True),
        "triple": attr.string(
            mandatory = True,
            doc = "Rust target triple in the release asset name, e.g. x86_64-unknown-linux-gnu.",
        ),
    },
)
