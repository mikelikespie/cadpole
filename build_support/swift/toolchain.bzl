"""A pinned, Bazel-downloaded Swift toolchain for Linux.

rules_swift finds Swift on Linux by sniffing `swiftc` on PATH from a
`local = True` repository rule (`@build_bazel_rules_swift_local_config`). That
makes every Linux build depend on whatever the machine happens to have
installed, which can silently diverge from the Mac's. No hermetic Linux Swift
toolchain is published on the BCR, so this repository rule:

  1. downloads the official swift.org tarball for the pinned version (sha256
     checked) into the external repository,
  2. runs the same feature probes rules_swift's autoconfiguration would run
     against that `swiftc`, and
  3. generates the same `swift_toolchain` / `toolchain` targets, rooted at the
     downloaded tree.

`MODULE.bazel` then swaps it in for rules_swift's sniffing repo with
`override_repo`, so `register_toolchains("@build_bazel_rules_swift_local_config//:all")`
inside rules_swift picks this one up; nothing else in the build changes.

On macOS the rule emits the same Xcode toolchain rules_swift would, so the
override is a no-op there.

Hermeticity caveat, stated plainly: rules_swift's `swift_toolchain` takes the
toolchain as an absolute `root` path, not as declared action inputs. The
version is pinned and Bazel fetches it, and the version string is an action
input via `version_file`, but the toolchain files themselves are not inputs.
That is enough for reproducible local/CI builds; it is not enough to execute
Linux Swift actions remotely. The tarball also expects the usual Ubuntu 24.04
system libraries (libcurl4, libxml2, libedit2, libsqlite3-0, libncurses6,
libpython3, tzdata); `ldd usr/bin/swift-frontend` in the fetched repo lists
anything missing.
"""

_LINUX_BUILD = """\
load(
    "@build_bazel_rules_swift//swift/toolchains:swift_toolchain.bzl",
    "swift_toolchain",
)
load(
    "@build_bazel_rules_swift//swift/toolchains:xcode_swift_toolchain.bzl",
    "xcode_swift_toolchain",
)

package(default_visibility = ["//visibility:public"])

# rules_swift's own Linux autoconfiguration emits this target too, and its
# darwin toolchain registration refers to it by name. Replacing that repo
# without it makes any macOS-targeting configuration fail analysis with
# "no such target ...//:xcode-toolchain" -- which matters here because an
# Apple build driven from a Linux client with a macOS execution platform
# resolves the darwin toolchain on the client. It is only a target definition;
# nothing analyses it unless a darwin configuration asks for it.
xcode_swift_toolchain(
    name = "xcode-toolchain",
    features = ["swift.module_map_no_private_headers"],
)

# For //build_support/swift:pinned_version_test.
exports_files(["swift_version"])

# Generated by //build_support/swift:toolchain.bzl for Swift {version}.
swift_toolchain(
    name = "linux-toolchain",
    arch = "{cpu}",
    # rules_swift's worker spawns `swift` without an absolute argv[0], so
    # swift-driver locates `swift-frontend` via PATH rather than next to
    # itself; with --incompatible_strict_action_env PATH is just the system
    # dirs and every modulewrap action dies with "unknown or missing
    # subcommand 'swift-frontend'". Put the toolchain's bin dir first.
    env = {{"PATH": "{root}/bin:/usr/bin:/bin"}},
    features = [{feature_list}],
    os = "linux",
    root = "{root}",
    version_file = "swift_version",
)

toolchain(
    name = "linux-swift-toolchain-{cpu}",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:{cpu}",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:{cpu}",
    ],
    toolchain = ":linux-toolchain",
    toolchain_type = "@build_bazel_rules_swift//toolchains:toolchain_type",
)
"""

# What rules_swift's autoconfiguration emits on macOS; kept identical so that
# overriding its repo changes nothing on a Mac.
_DARWIN_BUILD = """\
load(
    "@build_bazel_rules_swift//swift/toolchains:xcode_swift_toolchain.bzl",
    "xcode_swift_toolchain",
)

package(default_visibility = ["//visibility:public"])

xcode_swift_toolchain(
    name = "xcode-toolchain",
    features = ["swift.module_map_no_private_headers"],
)
"""

def _swift_succeeds(ctx, swiftc, *args):
    return ctx.execute([swiftc] + list(args)).return_code == 0

# Feature probes, mirroring rules_swift's swift_autoconfiguration.bzl
# (_FEATURE_CHECKS) so the generated toolchain matches what it would detect.
def _check_lld_gc_workaround(ctx, swiftc, tmp):
    src = tmp.get_child("main.swift")
    ctx.file(src, 'print("Hello")\n')
    return _swift_succeeds(
        ctx,
        swiftc,
        src,
        "-use-ld=lld",
        "-Xlinker",
        "-z",
        "-Xlinker",
        "nostart-stop-gc",
    )

def _check_upcoming_features(ctx, swiftc, _tmp):
    return _swift_succeeds(ctx, swiftc, "-version", "-enable-upcoming-feature", "BareRegexLiteralSyntax")

def _check_language_mode_6(ctx, swiftc, _tmp):
    result = ctx.execute([swiftc, "-version"])
    if result.return_code != 0:
        return False
    _, _, rest = result.stdout.partition("swiftlang-")
    major, _, _ = rest.partition(".")
    return major.isdigit() and int(major) >= 6

_FEATURE_CHECKS = {
    "swift.lld_gc_workaround": _check_lld_gc_workaround,
    "swift._supports_upcoming_features": _check_upcoming_features,
    "swift._supports_v6": _check_language_mode_6,
}

# Always on for Linux in rules_swift's generated toolchain.
_LINUX_FIXED_FEATURES = [
    "swift.module_map_no_private_headers",
    "swift.use_autolink_extract",
    "swift.use_module_wrap",
]

def _compute_features(ctx, swiftc):
    features = []
    for feature, check in _FEATURE_CHECKS.items():
        tmp = ctx.path("tmp.probe." + feature.replace(".", "_"))
        ctx.execute(["mkdir", "-p", str(tmp)])
        features.append(feature if check(ctx, swiftc, tmp) else "-" + feature)
        ctx.delete(tmp)
    return features + _LINUX_FIXED_FEATURES

def _linux_cpu(arch):
    if arch in ("amd64", "x86_64"):
        return "x86_64"
    if arch in ("aarch64", "arm64"):
        return "aarch64"
    fail("unsupported Linux cpu for the pinned Swift toolchain: " + arch)

def _ubuntu_release(ctx):
    """The host's Ubuntu release (VERSION_ID, e.g. "26.04") from /etc/os-release.

    swift.org builds a tarball per Ubuntu release, linked against that release's
    system libraries (26.04 ships only libxml2.so.16; the 24.04 build needs
    libxml2.so.2), so the right one depends on the host. Watching the file makes
    an OS upgrade fetch the toolchain again.
    """
    ctx.watch("/etc/os-release")
    fields = {}
    for line in ctx.read("/etc/os-release").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            fields[key] = value.strip().strip('"')
    if fields.get("ID") != "ubuntu":
        fail("pinned Swift toolchain: needs Ubuntu, found " + fields.get("ID", "unknown"))
    release = fields.get("VERSION_ID", "")
    if release not in ctx.attr.sha256:
        fail("pinned Swift toolchain: no swift.org tarball pinned for Ubuntu {} (pinned: {})".format(
            release,
            ", ".join(sorted(ctx.attr.sha256.keys())),
        ))
    return release

def _impl(ctx):
    if ctx.os.name.startswith("mac"):
        ctx.file("BUILD.bazel", _DARWIN_BUILD)
        return
    if ctx.os.name != "linux":
        fail("pinned Swift toolchain: unsupported OS " + ctx.os.name)

    cpu = _linux_cpu(ctx.os.arch)
    release = _ubuntu_release(ctx)
    url = ctx.attr.url_template.format(
        version = ctx.attr.version,
        release = release,
        release_nodot = release.replace(".", ""),
    )
    ctx.download_and_extract(
        url = url,
        sha256 = ctx.attr.sha256[release],
        stripPrefix = ctx.attr.strip_prefix.format(version = ctx.attr.version, release = release),
    )

    root = ctx.path("usr")
    swiftc = root.get_child("bin").get_child("swiftc")
    if not swiftc.exists:
        fail("pinned Swift toolchain: no usr/bin/swiftc under " + str(root))

    version = ctx.execute([swiftc, "-version"])
    if version.return_code != 0:
        fail(
            "pinned Swift toolchain: `swiftc -version` failed (missing system libraries? " +
            "run `ldd " + str(root) + "/bin/swift-frontend`):\n" + version.stderr,
        )
    ctx.file("swift_version", version.stdout.strip(), executable = False)

    ctx.file("BUILD.bazel", _LINUX_BUILD.format(
        cpu = cpu,
        feature_list = ", ".join(['"{}"'.format(f) for f in _compute_features(ctx, swiftc)]),
        root = str(root),
        version = ctx.attr.version,
    ))

swift_linux_toolchain = repository_rule(
    implementation = _impl,
    doc = "Downloads a pinned swift.org Linux toolchain and exposes it as rules_swift's toolchain.",
    attrs = {
        "version": attr.string(mandatory = True, doc = "swift.org release, e.g. 6.3.3"),
        "sha256": attr.string_dict(
            mandatory = True,
            doc = "sha256 of the x86_64 tarball per Ubuntu release (VERSION_ID), e.g. {\"24.04\": ..., \"26.04\": ...}",
        ),
        "url_template": attr.string(
            default = "https://download.swift.org/swift-{version}-release/ubuntu{release_nodot}/swift-{version}-RELEASE/swift-{version}-RELEASE-ubuntu{release}.tar.gz",
        ),
        "strip_prefix": attr.string(default = "swift-{version}-RELEASE-ubuntu{release}"),
    },
    # Not `local`: the result depends only on the pinned attrs, so Bazel may
    # cache it across restarts (unlike rules_swift's PATH sniffing).
)
