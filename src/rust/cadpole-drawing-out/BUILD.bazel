load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cadpole_drawing_out",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//src/rust/cadpole-core:cadpole_core",
        "//src/rust/cadpole-drawing:cadpole_drawing",
        "@crates//:chrono",
        "@crates//:dxf",
        "@crates//:miniz_oxide",
        "@crates//:pdf-writer",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "cadpole_drawing_out_test",
    size = "small",
    crate = ":cadpole_drawing_out",
    deps = ["//src/rust/cadpole-import-2d:cadpole_import_2d"],
)
