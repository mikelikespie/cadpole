load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cadpole_field",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//src/rust/cadpole-core:cadpole_core",
    ],
)

rust_test(
    name = "cadpole_field_test",
    crate = ":cadpole_field",
    # The accuracy and solidity tests contour a handful of ~100^3 grids:
    # about 160 s of work run one at a time in a debug build, 50-58 s on an
    # idle machine with the default test threads, the longest single case
    # (a field chamfer or fillet of a plain box) about 27 s. That sat at the
    # 60 s limit of a small test and timed out under a full build's load, so
    # this is medium (300 s): room for load, still short of hiding a hang.
    size = "medium",
)

# The crate's sources as files, for //src/rust/cadpole-wasm:transcendental_lint_test:
# no f64 math method on the geometry path outside cadpole_core::fmath.
filegroup(
    name = "rust_sources",
    srcs = glob(["src/**/*.rs"]),
)
