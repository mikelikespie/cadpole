load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cadpole_print",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//src/rust/cadpole-core:cadpole_core",
    ],
)

rust_test(
    name = "cadpole_print_test",
    size = "medium",  # 10 s: the plating property tests pack a few dozen random plates
    crate = ":cadpole_print",
    # The packer's inner loops are bit tests over rasters; unoptimised they
    # take ten times as long, and the property tests with them.
    rustc_flags = ["-Copt-level=2"],
)
