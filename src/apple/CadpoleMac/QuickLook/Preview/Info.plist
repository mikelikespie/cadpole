<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Cadpole Plates Preview</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<!-- The 3D view takes fingers on a touch display itself
	     (View/TouchRecognizer.swift): no made-up mouse clicks and scrolls
	     from them (Apple's TN3212). -->
	<key>NSIsTouchNative</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Apache-2.0</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLIsDataBasedPreview</key>
			<false/>
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- The app's own (Info.plist.in), and Bambu Studio's: since 2.9.1
				     it imports com.bambulab.3mf for .3mf, and Finder gives files that. -->
				<string>org.3mf.3mf</string>
				<string>com.bambulab.3mf</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>CadpolePlatePreviewController</string>
	</dict>
</dict>
</plist>
