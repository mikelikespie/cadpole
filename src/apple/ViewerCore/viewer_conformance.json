    {"select": 2, "show": "loading", "starts": 2},
    {"select": 3, "show": "loading", "starts": 3, "cancels": [2]},
    {"finish": 3, "outcome": "present"},
    {"finish": 2, "outcome": "drop"},
    {"expectSelected": 3, "expectReady": [1, 3]}
   ]},
  {"name": "a loaded plate shows at once; a plate already loading is not loaded twice",
   "steps": [
    {"select": 1, "show": "loading", "starts": 1},
    {"select": 1, "show": "loading", "starts": null},
    {"finish": 1, "outcome": "present"},
    {"prefetch": [2, 3], "starts": 2},
    {"prefetch": [2, 3], "starts": null},
    {"finish": 2, "outcome": "keep"},
    {"select": 2, "show": "model", "starts": null},
    {"select": 1, "show": "model", "starts": null}
   ]},
  {"name": "a switch cancels a neighbour loading ahead, so the chosen plate goes first",
   "steps": [
    {"select": 1, "show": "loading", "starts": 1},
    {"finish": 1, "outcome": "present"},
    {"prefetch": [2], "starts": 2},
    {"select": 5, "show": "loading", "starts": 5, "cancels": [2]},
    {"finish": 2, "outcome": "drop"},
    {"finish": 5, "outcome": "present"},
    {"select": 2, "show": "loading", "starts": 2}
   ]},
