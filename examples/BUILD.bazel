load("@aspect_rules_js//js:defs.bzl", "js_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "star_files",
    srcs = glob(["*.star"]),
)

# The fixture files `asset("...")` resolves in the examples. `cadpole eval
# examples/x.star` finds them the same way, by looking in `./assets` next to
# the script.
filegroup(
    name = "assets",
    srcs = glob(["assets/*"]),
)

# An illustrated assembly guide for gear_toy.star (docs/illustrations.md),
# as the JavaScript rules take a data file.
js_library(
    name = "gear_toy_guide",
    srcs = ["gear_toy.guide.json"],
)
