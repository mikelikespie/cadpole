# Sketch constraints: a profile solved from dimensions, not coordinates.
s = constrained_sketch(XY, name="profile")
a = s.point(0, 0, name="a", fix=True)
b = s.point(38, 2, name="b")
c = s.point(41, 9, name="c")
d = s.point(12, 11, name="d")
e = s.point(9, 31, name="e")
f = s.point(-2, 29, name="f")
foot = s.line(a, b, name="foot")
toe = s.line(b, c, name="toe")
step = s.line(c, d, name="step")
inner = s.line(d, e, name="inner")
cap = s.line(e, f, name="cap")
back = s.line(f, a, name="back")
hole = s.circle(s.point(30, 4, name="hc"), 2, name="hole")
s.constrain("perpendicular", foot, toe)
s.constrain("parallel", foot, step)
s.constrain("parallel", back, inner)
s.constrain("parallel", foot, cap)
s.constrain("distance", a, f, 30, name="height")
s.constrain("distance", "hc", foot, 5, name="hole up")
s.constrain("radius", hole, 2.5, name="bore")
# snippet
s.constrain("horizontal", foot)
s.constrain("vertical", back)
s.constrain("equal", toe, cap)
s.constrain("distance", a, b, 40, name="length")
s.constrain("distance", b, c, 10, name="thick")
s.constrain("distance", "hc", toe, 8, name="inset")
# end snippet
assert_eq(s.dof(), 0)
part = extrude(s, 16, name="part")
part.material(color="#6fbfa8", roughness=0.4)
